// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model StoreScan {
  id         String   @id @default(cuid())
  shop       String
  snapshot   String
  kpis       String
  createdAt  DateTime @default(now())
  recommendations Recommendation[]
}

model Recommendation {
  id          String   @id @default(cuid())
  shop        String
  scanId      String?
  scan        StoreScan? @relation(fields: [scanId], references: [id], onDelete: SetNull)
  category    String
  title       String
  description String
  impact      String
  priority    String
  toolSlug    String?
  status      String   @default("pending")
  createdAt   DateTime @default(now())
}

model AgentMessage {
  id        String   @id @default(cuid())
  shop      String
  role      String
  content   String
  createdAt DateTime @default(now())
}

model AutomationRun {
  id        String   @id @default(cuid())
  shop      String
  action    String
  details   String
  status    String
  createdAt DateTime @default(now())
}

model SmsRecoveryLog {
  id           String   @id @default(cuid())
  shop         String
  checkoutId   String
  phone        String
  message      String
  status       String
  twilioSid    String?
  errorMessage String?
  createdAt    DateTime @default(now())

  @@index([shop, checkoutId])
}

model ShopSettings {
  shop                String   @id
  agentAutoExecute    Boolean  @default(false)
  autoSmsRecovery     Boolean  @default(false)
  smsConsentConfirmed Boolean  @default(false)
  smsTemplate         String?
  updatedAt           DateTime @updatedAt
}
